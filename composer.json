{
  "name": "canprinto/canprinto",
  "description": "WordPress-Plugin für On-Demand-Print (Canprinto)",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Canprinto\\": "src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "scripts": {
    "cs": "php-cs-fixer fix --diff --allow-risky=yes",
    "stan": "phpstan analyse --memory-limit=1G"
  }
}
